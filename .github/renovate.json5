{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	// Shared policy: https://github.com/seijikohara/renovate-config
	extends: ['github>seijikohara/renovate-config:default.json5'],
	packageRules: [
		{
			description: 'Group the Rust (Cargo) backend dependencies',
			matchManagers: ['cargo'],
			groupName: 'rust',
		},
		{
			description: 'Group the Tauri frontend packages',
			groupName: 'tauri',
			matchPackageNames: ['@tauri-apps/*'],
		},
		{
			// config:recommended groups react, react-dom, and their type definitions as 'react monorepo'.
			// This rule moves react and react-dom to the 'react' group, so it takes the type definitions
			// too. Otherwise a React major arrives in two PRs that can merge apart.
			description: 'Group React, its type definitions, and its Vite plugin',
			groupName: 'react',
			matchPackageNames: [
				'react',
				'react-dom',
				'@types/react',
				'@types/react-dom',
				'@vitejs/plugin-react',
			],
		},
		{
			description: 'Group the TanStack packages',
			groupName: 'tanstack',
			matchPackageNames: ['@tanstack/*'],
		},
		{
			description: 'Group the Tiptap editor packages',
			groupName: 'tiptap',
			matchPackageNames: ['@tiptap/*'],
		},
		{
			description: 'Group Tailwind CSS packages',
			groupName: 'tailwind',
			matchPackageNames: ['tailwindcss', '@tailwindcss/*'],
		},
		{
			description: 'Group the test toolchain',
			groupName: 'testing',
			matchPackageNames: ['vitest', '@testing-library/*', 'jsdom'],
		},
		{
			// oxlint declares the oxlint-tsgolint version it needs as a peer dependency,
			// and oxlint-tsgolint moves to a new major with TypeScript. Keep majors in the
			// same PR so oxlint never lands without a matching oxlint-tsgolint.
			description: 'Group the oxc linting and formatting toolchain',
			groupName: 'linting and formatting',
			matchPackageNames: ['oxlint', 'oxfmt', 'oxlint-tsgolint'],
			separateMajorMinor: false,
		},
		{
			description: 'Group the build toolchain',
			groupName: 'build toolchain',
			matchPackageNames: ['vite', 'typescript'],
		},
		{
			// Later rules win. Exclude the React type definitions so the react group above keeps them.
			description: 'Group TypeScript type definitions outside the react group',
			groupName: 'type definitions',
			matchPackageNames: ['@types/*', '!@types/react', '!@types/react-dom'],
		},
	],
}
